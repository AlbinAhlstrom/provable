{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "2.0.0",
  "name": "Provable Diamond DAG Protocol",
  "description": "Graph engineering task DAG with single-context TDD implementation, parallel context-isolated verifiers, and coordinator merge gate.",
  "entry_point": "routing-role",
  "roles": [
    "routing-role",
    "tdd-worker-role",
    "research-role",
    "hypothesis-role",
    "debug-role",
    "architecture-verifier",
    "code_smell-verifier",
    "test-verifier",
    "enforcement-role",
    "refinement-role"
  ],
  "intents": {
    "QUESTION": {
      "initial_route": "research-role",
      "terminal_gate": "enforcement-role"
    },
    "HYPOTHESIS": {
      "initial_route": "hypothesis-role",
      "terminal_gate": "enforcement-role"
    },
    "FEATURE": {
      "initial_route": "tdd-worker-role",
      "diamond_fan_out": [
        "architecture-verifier",
        "code_smell-verifier",
        "test-verifier"
      ],
      "merge_coordinator": "enforcement-role"
    },
    "BUGFIX": {
      "initial_route": "debug-role",
      "diamond_fan_out": [
        "architecture-verifier",
        "code_smell-verifier",
        "test-verifier"
      ],
      "merge_coordinator": "enforcement-role"
    }
  },
  "transitions": {
    "routing-role": ["tdd-worker-role", "debug-role", "research-role", "hypothesis-role"],
    "tdd-worker-role": {
      "fan_out": ["architecture-verifier", "code_smell-verifier", "test-verifier"]
    },
    "debug-role": {
      "fan_out": ["architecture-verifier", "code_smell-verifier", "test-verifier"]
    },
    "architecture-verifier": ["enforcement-role"],
    "code_smell-verifier": ["enforcement-role"],
    "test-verifier": ["enforcement-role"],
    "research-role": ["enforcement-role"],
    "hypothesis-role": ["enforcement-role"],
    "enforcement-role": {
      "pass": {
        "reversible": "walkthrough_presentation",
        "irreversible": "human_gate_approval"
      },
      "fail": "refinement-role"
    },
    "refinement-role": ["implementation_plan.md"]
  },
  "invariants": {
    "topology_pattern": "diamond_dag",
    "stop_rule_enforced": true,
    "sequential_work_isolated_to_single_worker": true,
    "verifier_context_isolation": true,
    "single_merge_coordinator": "enforcement-role",
    "human_gate_for_irreversible_edges": true,
    "context_canary": "[🛡️ Clanker Active]"
  }
}
