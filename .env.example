# Provable AppGen Engine — Environment Configuration Example
# Copy this file to .env and configure your LLM provider API key.

# Google Gemini API Key (Recommended default for gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternatively, OpenAI API Key or Custom Endpoint
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_API_KEY=your_key_here
# LLM_MODEL=gemini-2.5-flash
