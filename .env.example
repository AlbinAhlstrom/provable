# Provable AppGen Engine — Environment Configuration Example
# Copy this file to .env and configure your LLM provider API key.

# Google Gemini API Key (Recommended default for gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: cap hidden "thinking" tokens (low|medium|high; empty = provider default). Default: low.
# A measured Gemini call went from 259 s / 35k tokens to 5 s / 1.5k tokens at "low".
# LLM_REASONING_EFFORT=low

# Optional: use a different model for one stage (stage names are upper-cased), e.g. have a different model
# write the TDD tests than the one writing the code:
# (Recommended: with one model, a misreading of a spec passes its own test; the Studio flags that.)
# LLM_MODEL_RED_TEST_GENERATION=gemini-2.5-pro

# Alternatively, OpenAI API Key or Custom Endpoint
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_API_KEY=your_key_here
# LLM_MODEL=gemini-2.5-flash

# Optional: SEK per USD used when a run records what its LLM calls cost (default 10.0).
# PROVABLE_USD_SEK=10.0

# Optional: switch provider with one line. The named provider supplies the endpoint, the default model and the
# setting its key is read from (gemini: GEMINI_API_KEY, openai: OPENAI_API_KEY, anthropic and anthropic-opus: CLAUDE_API_KEY), so the keys
# can stay side by side in this file.
# When set, OPENAI_BASE_URL, LLM_API_KEY and LLM_MODEL are ignored; LLM_MODEL_<STAGE> still applies.
# Under anthropic the pitch expansion runs on claude-sonnet-5-5 (LLM_MODEL_PROMPT_EXPANSION overrides it).
# Providers are listed in backend/llm_provider.py.
# LLM_PROVIDER=gemini

# Hosted engine (login on, CLERK_ISSUER set): every user brings their own LLM key, added in the Studio.
# The keys above are then used only by the users named here (comma-separated Clerk user ids).
# LLM_HOUSE_USERS=user_xxx
# Encrypts the users' keys at rest. Required when hosted. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PROVABLE_KEY_SECRET=
# Where the encrypted keys live; defaults to provable-keys.db beside the workspace.
# PROVABLE_KEYS_DB=
