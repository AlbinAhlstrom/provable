{
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(python scripts/agent_preflight_check.py:*)"
    ],
    "deny": [
      "Edit(/workspace/**)",
      "Read(/.env)",
      "Read(/.env.local)",
      "Bash(python run.py:*)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add .)",
      "Bash(git commit -a:*)",
      "Bash(git commit --all:*)",
      "Bash(git commit -am:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__remote-devices__device_bash|mcp__remote-devices__device_commit_files",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/claude_hooks/workspace_guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/claude_hooks/canary_stop.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
